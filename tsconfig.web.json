{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "tsBuildInfoFile": "node_modules/.tmp/web.tsbuildinfo"
  },
  "include": ["src/web", "src/shared"],
  "exclude": ["**/* [0-9].*"]
}
