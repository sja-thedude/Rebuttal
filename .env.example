# Copy to .dev.vars for local development. Set production values with `wrangler secret put <NAME>`.
# Sandbox only: never put live PayPal credentials here.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
